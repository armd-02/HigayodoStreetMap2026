    "site_title": {
        "ja": "ひがよど文化祭 会場周遊マップ2026",
        "en": "Higayodo Street Map 2026"
    },
    "site_subtitle": {
        "ja": "ひがよど文化祭2026 会場・出展情報",
        "en": "Higayodo Cultural Festival 2026 venues and events"
